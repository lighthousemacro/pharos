# ---- Chain ----
# Local hardhat node by default. Point at Arc testnet for a real deploy.
PHAROS_RPC_URL=http://127.0.0.1:8545
PHAROS_CHAIN_ID=31337
# Hardhat account #0 default key (local only — NEVER use a real key here).
PHAROS_DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- Pricing engine ----
PHAROS_DB_PATH=/Users/bob/LHM/Data/databases/Lighthouse_Master.db
PHAROS_PRICING_URL=http://127.0.0.1:6910

# ---- Oracle agent (official prints) ----
# Reuses the Lighthouse FRED key. Falls back to the LHM pipeline .env if unset.
FRED_API_KEY=
BLS_API_KEY=

# ---- Market-creator agent ----
# How many days ahead of a release to open the market.
PHAROS_LEAD_DAYS=14
# USDC (6dp) seeded as initial AMM liquidity per market.
PHAROS_SEED_USDC=5000
